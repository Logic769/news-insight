# 复制为 .env 后按需填写；.env 不进版本库
# ---- 上游 news-crawler ----
# 宿主机直跑 API 时用 http://127.0.0.1:8000，容器内访问宿主机用 host.docker.internal
NEWS_BASE_URL=http://host.docker.internal:8000
NEWS_API_KEY=
# auto | live | demo
NEWS_SOURCE_MODE=auto

# ---- LLM（OpenAI 兼容接口）----
# DeepSeek: https://api.deepseek.com + deepseek-chat
# OpenAI:   https://api.openai.com/v1 + gpt-4o-mini
# Ollama:   http://host.docker.internal:11434/v1 + qwen2.5:7b（key 随便填）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

INSIGHT_PORT=8020
MAX_TAGS_PER_ARTICLE=5
