# 复制为 .env 后按需填写；.env 不进版本库，也不会被拷进镜像
# ---- 上游 news-crawler ----
# 宿主机直跑 API 时用 http://127.0.0.1:8000，容器内访问宿主机用 host.docker.internal
NEWS_BASE_URL=http://host.docker.internal:8000
NEWS_API_KEY=
# auto | live | demo
NEWS_SOURCE_MODE=auto
NEWS_PAGE_SIZE=20
NEWS_TIMEOUT=15

# ---- LLM（OpenAI 兼容接口）----
# DeepSeek: https://api.deepseek.com + deepseek-chat
# OpenAI:   https://api.openai.com/v1 + gpt-4o-mini
# Ollama:   http://host.docker.internal:11434/v1 + qwen2.5:7b（key 随便填）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60
LLM_TEMPERATURE=0
# 供应商侧同时请求上限；超过时本地排队
LLM_MAX_CONCURRENCY=100

# ---- 本服务入站鉴权 ----
# 设置 INSIGHT_API_KEY 后，除 /health、/docs 外都需 X-API-Key 或 Authorization: Bearer
# 设为 1 强制鉴权：未配置 key 时业务请求一律 401
INSIGHT_API_KEY=
INSIGHT_REQUIRE_AUTH=0

# ---- 吞吐与保留 ----
# 分析并发（同时在途的文章数，1–200）；供应商限流时调低
ANALYZE_CONCURRENCY=100
# 每多少篇提交一次 SQLite 事务
ANALYZE_WRITE_BATCH=50
# 异步作业排队上限（queued + running），超过 POST /v1/jobs 返回 429
ANALYZE_MAX_PENDING_JOBS=50
# 从上游补正文的并发请求数（1–64）
NEWS_DETAIL_CONCURRENCY=16
# 分析结果保留天数；0 表示不自动清理
RETENTION_DAYS=90

# ---- 运行参数 ----
# 默认只绑回环；要让其他机器访问改成 0.0.0.0，并先配好 INSIGHT_API_KEY
INSIGHT_BIND=127.0.0.1
INSIGHT_PORT=8020
MAX_TAGS_PER_ARTICLE=5
TAG_BODY_CHARS=1200
EXTRACT_BODY_CHARS=6000
# 数据卷：默认命名卷 insight_data；设成 ./data 则直接落宿主机目录（Linux 需先 chown 10001）
# INSIGHT_DATA_DIR=./data
